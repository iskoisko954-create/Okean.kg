rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Must be the same address as ADMIN_EMAIL in firebase-config.js
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'admin@okeankafe.kg';
    }

    // Public menu: everyone can read, only the admin can change.
    match /products/{id}   { allow read: if true; allow write: if isAdmin(); }
    match /categories/{id} { allow read: if true; allow write: if isAdmin(); }

    // Private messages/orders: customers may only CREATE a well-formed order.
    // Only the signed-in admin can read, update or delete them.
    match /orders/{id} {
      allow create: if request.resource.data.keys().hasOnly(['items','total','name','phone','address','note','type','status','createdAt','lang','code'])
        && request.resource.data.keys().hasAll(['items','total','name','phone','type','status','createdAt','code'])
        && request.resource.data.status == 'new'
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 50
        && request.resource.data.total is number && request.resource.data.total >= 0 && request.resource.data.total <= 1000000
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
        && request.resource.data.phone is string && request.resource.data.phone.size() >= 6 && request.resource.data.phone.size() <= 30
        && request.resource.data.type in ['delivery','pickup','dine']
        && request.resource.data.code is string && request.resource.data.code.size() <= 8;
      allow read, update, delete: if isAdmin();
    }
  }
}
